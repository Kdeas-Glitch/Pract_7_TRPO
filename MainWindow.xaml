<Window x:Class="Pract_7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pract_7"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListView x:Name="list"
            ItemsSource="{Binding Movies}"
            SelectedItem="{Binding CurrentMovie}" SelectionChanged="Change"
                  >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="5 0">Название: </TextBlock>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Title}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="5 0">Жанр: </TextBlock>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Genre}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="5 0">Продолжительность: </TextBlock>
                            <TextBlock TextWrapping="Wrap" Text="{Binding DurationMinutes}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="5 0">Год Выпуска: </TextBlock>
                            <TextBlock TextWrapping="Wrap" Text="{Binding ReleaseYear}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="5 0">Доступен: </TextBlock>
                            <TextBlock TextWrapping="Wrap" Text="{Binding IsAvailable}"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                
                <TextBlock Margin="0 5" Grid.Row="0">Фильтрация списка:</TextBlock>

                <TextBox Margin="0 5" Text="{Binding filtGenre,UpdateSourceTrigger=PropertyChanged}" LostFocus="Filter2"></TextBox>
                <TextBox Margin="0 5" Text="{Binding filMinYear,UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}" LostFocus="Filter2" ></TextBox>
            </StackPanel>

            <StackPanel Grid.Row="1" >
                <Button  Width="230" Margin="0 5" Click="Create">Создать новую запись</Button>
                <Button  Width="230" Margin="0 5" Click="ChangeWhole">Внести изменения</Button>
                <Button  Width="230" Margin="0 5" Click="Button_Click">Внести изменения частично</Button>
                <Button  Width="230" Margin="0 5" Click="Delete">Удалить выбранное</Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="2" DataContext="{Binding CurrentMovie}" x:Name="Current">
            
            <TextBlock Margin="0 5">Название:</TextBlock>
            <TextBox Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}"></TextBox> 
            
            <TextBlock Margin="0 5">Жанр:</TextBlock>
            <TextBox Text="{Binding Genre,UpdateSourceTrigger=PropertyChanged}"></TextBox>  
            
            <TextBlock Margin="0 5">Продолжительность:</TextBlock>
            <TextBox Text="{Binding DurationMinutes,UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}"></TextBox>  
            
            <TextBlock Margin="0 5">Год выпуска:</TextBlock>
            <TextBox Text="{Binding ReleaseYear,UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}"></TextBox>

            <TextBlock Margin="0 5">Доступен:</TextBlock>
            <CheckBox IsChecked="{Binding IsAvailable,UpdateSourceTrigger=PropertyChanged}"></CheckBox>
        </StackPanel>
        
    </Grid>
</Window>
